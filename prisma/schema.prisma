generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id            Int         @id @default(autoincrement())
  subject       String
  model1        String
  model2        String
  reviewerModel String?
  persona1      String      @default("None")
  persona2      String      @default("None")
  mode          String      @default("discussion")
  responseLength String     @default("medium")
  totalTurns    Int
  status        String      @default("active")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages Message[]      @relation()
}

model Message {
  id            Int         @id @default(autoincrement())
  conversationId Int
  speaker       String
  role          String
  content       String
  reviewStatus  String?
  turnNumber    Int
  createdAt     DateTime    @default(now())

  @@index([conversationId])

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
